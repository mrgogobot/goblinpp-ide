{
 "name": "goblin++",
 "displayName": "Goblin++",
 "version": "0.1.0-alpha.41",
 "languageId": "goblinpp",
 "fileExtensions": [
  ".gbl"
 ],
 "grammar": "grammar/goblinpp.json",
 "lsp": {
  "binary": "",
  "transport": "none",
  "capabilities": [
   "completion",
   "hover",
   "diagnostic",
   "definition",
   "folding",
   "documentSymbol",
   "codeAction",
   "formatting"
  ]
 },
 "snippets": "snippets/goblinpp.json",
 "diagnostics": "diagnostics/codes.json",
 "themes": "themes/",
 "docs": "docs/",
 "docsIndex": [
  "ARCHITECTURE.md",
  "ARRAY_MATH.md",
  "ARRAY_PLOTS.md",
  "BATCHES_STREAMING.md",
  "CHEMISTRY.md",
  "CLOCK_TIME.md",
  "COMPLETELY_MAD.md",
  "COMPOUND_UNITS.md",
  "CONTROL_FLOW.md",
  "DATA_MODULES_NATIVE.md",
  "DEPENDENCY_LICENSE_AUDIT.md",
  "DEVELOPMENT_BACKLOG.md",
  "ELECTRICAL_ENGINEERING.md",
  "ENCRYPTION_PROPOSAL.md",
  "EVIDENCE_REPORTING.md",
  "FITS.md",
  "FITS_BATCHES.md",
  "FITS_SUBSETS.md",
  "FLUID_MECHANICS.md",
  "FUNCTIONS.md",
  "GITHUB_FIRST_STEPS.md",
  "INTERACTION_AND_ARRAYS.md",
  "MATH.md",
  "MATRICES_COVARIANCE.md",
  "NETWORK_ACQUISITION.md",
  "NEXT_BUILD.md",
  "NUMERIC_AUDIT.md",
  "NUMERIC_REPRODUCIBILITY.md",
  "NUMERIC_TEXT.md",
  "ORBIT.md",
  "OUTPUTS.md",
  "PLOT_PROVENANCE.md",
  "PORTING_MATRIX.md",
  "PROTECTED_VALUES.md",
  "RANDOMNESS.md",
  "RESAMPLING.md",
  "RESOURCES_STREAMING.md",
  "SCIENTIFIC_READERS.md",
  "SECURITY.md",
  "STATISTICS.md",
  "STRINGS.md",
  "TABLE_JOINS.md",
  "TEST_RESULTS.md",
  "VECTORS_COORDINATES_KINEMATICS.md",
  "WB3_ROADMAP.md"
 ],
 "examples": "examples/",
 "unitRegistry": "units/registry.json",
 "functions": "functions/registry.json",
 "constants": "constants/registry.json",
 "rustInline": {
  "grammar": "grammar/rust.json",
  "authMode": "sha256-hash"
 },
 "cli": {
  "binary": "goblin++",
  "subcommands": [
   "run",
   "check",
   "compile",
   "freeze",
   "revise",
   "verify",
   "diff",
   "compare-value",
   "audit-ledger",
   "status",
   "lineage",
   "doctor",
   "capabilities",
   "fits-info",
   "fetch",
   "verify-fetch",
   "orbit",
   "evidence-report",
   "verify-report"
  ],
  "versionFlag": "--version"
 },
 "profiles": [
  "everyday",
  "GO_PARANOID",
  "COMPLETELY_MAD"
 ],
 "evidence": {
  "runDirPrefix": "runs/",
  "receiptFile": "receipt.json",
  "ledgerFile": ".goblin/custody-ledger.jsonl",
  "ledgerHeadFile": ".goblin/custody-ledger-head.json",
  "freezeFileSuffix": ".freeze.json"
 },
 "unitSyntax": "compound",
 "unitExamples": [
  "kg*m^2/s^2",
  "m/s^2",
  "kg/(m*s^2)",
  "V",
  "ohm",
  "F",
  "H",
  "A",
  "W",
  "J",
  "kΩ",
  "µF"
 ],
 "minIDEVersion": "0.2.0",
 "minRustVersion": "1.92.0",
 "license": "MIT",
 "changelog": "CHANGELOG.md",
 "repository": "https://github.com/mrgogobot/goblinpp"
}